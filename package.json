{
  "name": "codechronicles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Experiencia editorial cinematográfica e interactiva sobre la historia de la programación.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "i18n:audit": "node scripts/i18n.mjs audit",
    "i18n:export": "node scripts/i18n.mjs export",
    "i18n:translate": "node scripts/i18n.mjs translate",
    "deploy": "npm run build && npx gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
